# 宿主反代站点配置样例 —— 放到 /etc/nginx/conf.d/<site>.conf
# 前提：web 容器把 80 映射到宿主的 127.0.0.1:${WEB_PORT}，所以这里只反代到回环地址。
# ⚠️ 80/443 若已被别的程序占用（面板之类），别抢——要么让它来管证书与反代，要么换端口。

server {
    listen 80;
    server_name <你的域名>;

    # 证书由宿主上的证书工具申请与续期（certbot / 面板），这里只认 443。
    # listen 443 ssl;
    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # ⚠️ 这个头决定后端生成的链接是 http 还是 https，漏了会出现「明明是 https 却跳 http」。
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
