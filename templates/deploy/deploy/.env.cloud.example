# 云端 .env 样例 —— 放到服务器的 /srv/${PROJECT_NAME}/.env，**不入库**。
# compose 默认只找自己所在目录的 .env，所以调用方一律显式 --env-file 指向它。

# ── 数据库 ──
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=${DB_NAME}
# ⚠️ Linux **绝对路径**；数据在宿主机上，不在容器里——容器删了数据不能跟着没。
MYSQL_DATA_DIR=/srv/${PROJECT_NAME}/mysql

# ── 应用 ──
${APP_ENV_PREFIX}_JWT_SECRET=please-generate-a-random-32-byte-secret
${APP_ENV_PREFIX}_JWT_EXPIRE_DAYS=7
# 同源部署（前端与 /api 同域）不需要 CORS，留空即可。
${APP_ENV_PREFIX}_CORS_ALLOWED_ORIGINS=

# ── 镜像 ──
ACR_REGISTRY=<你的镜像仓库地址>
ACR_NAMESPACE=${PROJECT_NAME}
# 版本由部署脚本传入，这里不写。
APP_VERSION=
